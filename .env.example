# Required only when sharing the dashboard on your LAN.
# Create a local .env file with a strong value; do not commit it.
CYBERQUANT_ADMIN_TOKEN=replace-with-a-long-random-value
CYBERQUANT_INITIAL_USERNAME=admin
CYBERQUANT_INITIAL_PASSWORD=use-a-unique-strong-password

# --- Forgot password: send reset links by email (optional) ---
# Without these, the reset link is printed in the server console and shown on screen for local use only.
# Leave BASE_URL unset to build links from the address the page was opened on. Set it only for an https domain.
# CYBERQUANT_BASE_URL=https://cyberquant.example.com
# CYBERQUANT_SMTP_HOST=smtp.gmail.com
# CYBERQUANT_SMTP_PORT=587
# CYBERQUANT_SMTP_USER=yourname@gmail.com
# CYBERQUANT_SMTP_PASSWORD=your-gmail-app-password
# CYBERQUANT_SMTP_FROM=yourname@gmail.com

# --- Sign in with Google (optional) ---
# GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=xxxxxxxx
